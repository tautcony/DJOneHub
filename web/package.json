{
  "name": "djonehub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "ant-design-vue": "^4.2.6",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "core-js@3.49.0": true
  }
}
